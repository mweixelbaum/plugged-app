{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "plugged.host - Desktop App",
  "mainBinaryName": "plugged",
  "version": "1.0.0",
  "identifier": "host.plugged.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PABLO Development",
    "copyright": "© 2026 PABLO Development",
    "licenseFile": "windows/LICENSE.rtf",
    "category": "Utility",
    "shortDescription": "plugged.host – kostenloses Hosting für Gameserver, Bots und kleine Dienste",
    "longDescription": "Native App für plugged.host: Gameserver, Bots und kleine Dienste über das Panel verwalten.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["German", "English"]
      },
      "wix": {
        "language": ["de-DE", "en-US"]
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
